# Single place for the product identity. Edit, then run scripts/build_app.sh.
APP_NAME="DuckSCP"
BUNDLE_ID="ro.corsicanu.duckscp"
APP_VERSION="1.0.3"
COPYRIGHT="Copyright © 2026 corsicanu. GPL-3.0-or-later."
# Identity used before the rename; its data and Keychain entries are migrated on first launch.
LEGACY_APP_NAME="MacSCP"
LEGACY_BUNDLE_ID="ro.corsicanu.macscp"
# GitHub repository ("owner/name") whose Releases the update checker watches.
UPDATE_REPO="corsicanu/DuckSCP"
# Code-signing identity (in the login keychain). A stable identity keeps Keychain access
# and update checks working across versions; "-" (ad hoc) is used if it is missing.
SIGN_IDENTITY="DuckSCP Self-Signed"
